# =============================================================================
# ChemSafe-KG 环境变量配置模板
# =============================================================================
# 使用方式: 复制本文件为 .env, 填入真实值后运行
# cp .env.example .env

# ── LLM API 配置 ──
# DeepSeek API (主选)
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ChatGLM API (备用)
# LLM_API_KEY=sk-your-chatglm-api-key-here
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# ── Neo4j 图数据库 ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── PostgreSQL / SQLite ──
# 开发环境使用 SQLite
DATABASE_URL=sqlite:///data/processed/chemsafe.db
# 生产环境切换到 PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/chemsafe

# ── EPA CompTox API ──
EPA_API_KEY=your-epa-api-key-here  # 可选

# ── 爬虫配置 ──
CRAWLER_DELAY=3.0                  # 请求间隔(秒), 遵守 robots.txt
CRAWLER_USER_AGENT=Mozilla/5.0 ChemSafe-KG/1.0 (Academic Project)
