# =============================================================================
# ChemSafe-KG .gitignore
# =============================================================================

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ── 环境变量 ──
.env

# ── 数据文件 ──
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
data/external/**
!data/external/.gitkeep

# ── 数据库文件 ──
*.db
*.sqlite3

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── 日志 ──
*.log
logs/

# ── HuggingFace 模型缓存（多项目共享，不计入本仓库） ──
.cache/huggingface/
**/.cache/huggingface/

# ── Notebook 临时输出 ──
.ipynb_checkpoints/
.aider*

# Temp scripts
_*.py

# Dataset release (large files, local only)
data/release/

# 期末汇报材料（不纳入代码仓库）
期末汇报材料/
